    {
      "name": "03 Login user - 200 OK with JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JWT has three parts', () => pm.expect(pm.response.json().token.split('.')).to.have.lengthOf(3));",
              "const token = pm.response.json().token; pm.collectionVariables.set('userToken', token); const parts = token.split('.'); parts[2] = (parts[2][0] === 'a' ? 'b' : 'a') + parts[2].slice(1); pm.collectionVariables.set('alteredToken', parts.join('.'));"
            ]
          }
        }
      ]
    },
