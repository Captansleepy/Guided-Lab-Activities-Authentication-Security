{
  "info": {
    "name": "CSC220 Week 9 - Authentication and Security",
    "description": "Run against a fresh lab database. Create an admin account in MongoDB before running request 19. npm run evidence supplies a temporary real MongoDB database and a seeded admin automatically. Uses dummy lab credentials only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "student1@example.com"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "password123"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
